# ============================================
# Referti Bio-Clinic — Environment Variables
# ============================================
# Copy this file to .env.local for development
# ============================================

# Supabase
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Encryption
MASTER_ENCRYPTION_KEY=  # Generate: openssl rand -hex 32
ENCRYPTION_KEY_VERSION=v1

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Bio-Clinic Referti <referti@bio-clinic.it>
CONTACT_EMAIL=gestione@bio-clinic.it

# SMS (Twilio) — Optional
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+39...

# Application
APP_URL=https://referti.bio-clinic.it
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4321,https://referti.bio-clinic.it

# Cloudflare
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...
