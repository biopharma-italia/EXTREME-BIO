  "faq": [
    {
      "q": "Come prenoto una visita?",
      "a": "Puoi prenotare online su miodottore.it/strutture/bioclinic, telefonando allo 079 956 1332, o tramite il sito bio-clinic.it."
    },
    {
      "q": "Come prenoto analisi del sangue?",
      "a": "Vai su bio-clinic.it/laboratorio/prenota/ per prenotare le analisi. Puoi anche chiamare lo 079 956 1332."
    },
    {
      "q": "Quali sono gli orari?",
      "a": "Lunedì-Venerdì 07:00-21:00, Sabato 08:00-14:00, Domenica chiuso."
    },
    {
      "q": "Dove si trova Bio-Clinic?",
      "a": "Via Renzo Mossa 23, 07100 Sassari. Parcheggio gratuito e nessuna barriera architettonica."
    },
    {
      "q": "Servono impegnativa e tessera sanitaria?",
      "a": "Per le analisi convenzionate SSN servono impegnativa e tessera sanitaria. Per visite private non serve impegnativa."
    },
    {
      "q": "Quanto costano le analisi?",
      "a": "I prezzi variano. Consulta il listino completo su bio-clinic.it/listino/ o chiama lo 079 956 1332."
    },
    {
      "q": "Come ritiro i referti?",
      "a": "I referti sono disponibili online su referti.bio-clinic.it oppure ritirali di persona presso la segreteria."
    },
    {
      "q": "Accettate pagamenti con carta?",
      "a": "Sì, accettiamo contanti, bancomat, carte di credito e pagamento elettronico."
    },
    {
      "q": "Fate visite a domicilio?",
      "a": "Alcuni servizi sono disponibili a domicilio. Contattaci allo 079 956 1332 per informazioni."
    },
    {
      "q": "Quanto tempo per i risultati delle analisi?",
      "a": "La maggior parte dei risultati è disponibile entro 24-72 ore. Esami particolari possono richiedere tempi più lunghi."
    }
  ]
}