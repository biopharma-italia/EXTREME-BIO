# Cloudflare Pages Redirects
# Docs: https://developers.cloudflare.com/pages/platform/redirects

# Redirect Slim Care progetto peso
/slim-care-progetto-peso /pages/slim-care.html 301
/slim-care-progetto-peso/ /pages/slim-care.html 301

# Redirect Medicina del Lavoro (SEO-friendly URL)
# Nota: Cloudflare Pages gestisce automaticamente .html -> senza estensione
/pages/medicina-lavoro /pages/medicina-del-lavoro-sassari 301
/pages/medicina-lavoro.html /pages/medicina-del-lavoro-sassari 301
/pages/medicina-lavoro/ /pages/medicina-del-lavoro-sassari 301
/medicina-del-lavoro-sassari /pages/medicina-del-lavoro-sassari 301
/medicina-del-lavoro-sassari/ /pages/medicina-del-lavoro-sassari 301

# Static HTML pages - serve directly (no fallback)
/pages/*.html /pages/:splat.html 200

# Redirect da /prestazioni/ a /pages/
/prestazioni/:procedure /pages/:procedure.html 301

# Redirect specifici per procedure con nomi diversi
/prestazioni/visita-cardiologica /pages/visita-cardiologica-ecg.html 301
/prestazioni/ecg /pages/visita-cardiologica-ecg.html 301

# Redirect laboratorio - solo per deep links esami (escludi index.html)
# Nota: evita match su index.html per prevenire loop
/laboratorio/esame-* /laboratorio/#:splat 301
/laboratorio/pack-* /laboratorio/#:splat 301

# Redirect servizi/laboratorio-analisi a laboratorio
/servizi/laboratorio-analisi /laboratorio/ 301
/servizi/laboratorio-analisi/ /laboratorio/ 301

# Genetica & Preparazione Esami - Explicit routes
/pages/genetica.html /pages/genetica.html 200
/pages/preparazione-esami.html /pages/preparazione-esami.html 200

# SEO: Consolidazione cannibalizzazione Pap Test
# pap-test-hpv.html -> duopap.html (stesso contenuto, DuoPap più completo)
/pages/pap-test-hpv.html /pages/duopap.html 301
/pages/pap-test-hpv /pages/duopap.html 301

# SEO-friendly URL: Mounjaro Tirzepatide Sassari
# Pagina principale in /mounjaro-tirzepatide-sassari/index.html
/pages/mounjaro-tirzepatide-sassari.html /mounjaro-tirzepatide-sassari/ 301
/pages/mounjaro-tirzepatide-sassari /mounjaro-tirzepatide-sassari/ 301
/mounjaro-sassari /mounjaro-tirzepatide-sassari/ 301
/tirzepatide-sassari /mounjaro-tirzepatide-sassari/ 301

# SEO-friendly URL: Contatti
/pages/contatti.html /contatti/ 301
/pages/contatti /contatti/ 301

