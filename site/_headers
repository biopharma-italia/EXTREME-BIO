# Cloudflare Pages Headers
# Docs: https://developers.cloudflare.com/pages/platform/headers

# ===========================================
# GLOBAL HEADERS (All pages)
# ===========================================
/*
  # Security Headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  
  # Cache Control (HTML: 5 min max, always revalidate — no stale snapshots)
  Cache-Control: public, max-age=300, must-revalidate

# ===========================================
# DEPRECATED FILES (force no-cache to kill CDN stale copies)
# ===========================================
